# InterSystems IRIS AI Hub Docker Image
# Primary (EAP 2027.1):
IRIS_IMAGE=iris-community:2027.1.0AI.109.0
# Alternative for judges testing on EAP 2026.3:
# IRIS_IMAGE=iris-community:2026.3.0AI.154.0

# Execution Mode:
# 'replay' -> Autonomous deterministic simulation using pre-recorded golden traces (zero API keys required)
# 'live'   -> Live invocation of InterSystems %AI.Agent connected to LLM provider
SYNAPSE_MODE=replay

# LLM Provider selection ('gemini' or 'openai')
LLM_PROVIDER=gemini

# Provider API Keys (leave empty for replay mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
